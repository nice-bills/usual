    "@mysten/sui": "^2.38.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.4.0",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "2.11.1",
    "@suimpp/mpp": "^0.9.0",
    "@tanstack/react-query": "^5.105.0",
    "jsqr": "^1.4.0",
    "mppx": "0.4.12",
    "next": "16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@e2e-dev/web": "^0.15.3",
    "@mysten/move-bytecode-template": "^0.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
