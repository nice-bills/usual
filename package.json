{
  "name": "usual",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:mock": "USUAL_MOCK=1 next dev",
    "test": "vitest run",
    "keys": "tsx scripts/keys.ts",
    "gate": "tsx --env-file=.env scripts/gate.ts",
    "seed": "tsx --env-file=.env scripts/seed-history.ts",
    "setup:allowances": "tsx --env-file=.env scripts/setup-allowances.ts",
    "proof": "tsx --env-file=.env scripts/proof.ts",
    "test:e2e": "e2e run",
    "check:walrus": "tsx --env-file=.env scripts/walrus-check.ts",
    "check:llm": "tsx --env-file=.env scripts/llm-check.ts",
    "check:rebuild": "tsx --env-file=.env scripts/live-rebuild.ts",
    "devnet:setup": "SUI_NETWORK=devnet TATUM_SUI_GRPC_URL=sui-devnet-grpc.gateway.tatum.io:443 tsx --env-file=.env scripts/create-test-dollar.ts",
    "testnet:setup": "tsx --env-file=.env scripts/create-test-dollar.ts",
    "rehearse": "bash scripts/rehearse.sh",
    "replay": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@mysten-incubation/memwal": "^0.1.11",
