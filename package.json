    "ai": "^7.0.0",
    "dotenv": "^18.0.9",
    "e2e": "^0.21.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
