# Copy to .env. Never commit .env.
# Leave everything empty and run `pnpm dev:mock` to try Usual with no keys.

TATUM_API_KEY=
TATUM_SUI_GRPC_URL=sui-testnet-grpc.gateway.tatum.io:443
SUI_NETWORK=testnet

MEMWAL_ACCOUNT_ID=          # owner's Walrus Memory account object ID (0x…), from memory.walrus.xyz
MEMWAL_PRIVATE_KEY=         # Usual's delegate private key (hex); `pnpm keys` generates it
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=usual

AGENT_SUI_PRIVATE_KEY=      # spender key for allowances and MPP payments (suiprivkey1…)
OWNER_SUI_PRIVATE_KEY=      # testnet demo owner, used only by scripts (seed, allowances)
PAYEE_MUM_PRIVATE_KEY=
PAYEE_GYM_PRIVATE_KEY=
PAYEE_STREAM_PRIVATE_KEY=
CAFE_RECIPIENT_ADDRESS=     # MPP merchant receiving address

USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# Free OpenAI-compatible LLM. Groq: https://console.groq.com/keys
# Hugging Face instead: LLM_BASE_URL=https://router.huggingface.co/v1, LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Leave LLM_API_KEY empty to use the built-in rule parser.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

OWNER_ADDRESS=              # the owner wallet allowed to drive the app (defaults to OWNER_SUI_PRIVATE_KEY's address)
SESSION_SECRET=             # any long random string
